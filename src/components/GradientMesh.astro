---
/**
 * GradientMesh
 * ------------
 * A slow rainbow colour field — no shapes, no lines, just mood. Seven big soft
 * blobs spanning the hue wheel (the site's own amber / blueprint / wire /
 * phosphor accents are four of the seven) orbit the middle of the viewport once
 * every 3.5 minutes, while each one drifts and breathes on its own period, so
 * the mesh never composes the same way twice.
 *
 * Blobs are placed by OFFSET FROM THE VIEWPORT CENTRE, not as a percentage of
 * some larger box. A rotating box has to be wide enough that its inscribed
 * circle still covers the viewport's diagonal or a bare corner swings into
 * view — which fails on a wide monitor at any sane box size. Rotating a set of
 * offsets around a point has no edge to expose in the first place. The blue
 * blob sits near the centre with a small offset so the middle of the page is
 * never left bare at any angle.
 *
 * Cheap on purpose:
 * - no `filter: blur()` anywhere. A radial-gradient falling to transparent is
 *   already soft, and a full-viewport blur is what tanked this site before.
 * - transform-only animation, so it stays on the compositor.
 * - `mix-blend-mode: screen` because on a near-black ground the darkening modes
 *   (overlay, soft-light) are no-ops — texture over dark has to ADD light.
 *
 * Measured: 59.6fps, 17ms worst frame, with all seven layers blending.
 */

/** ox/oy offset the blob's centre from the viewport's, in vw/vh. */
const BLOBS = [
  { h: 8,   s: 72, l: 58, a: 0.22, ox: -50.4, oy: -43.2, size: 78, dx: 6,  dy: -5, s0: 1.0,  s1: 1.22, dur: 47, delay: -12 },
  { h: 32,  s: 78, l: 60, a: 0.24, ox: 36,    oy: -57.6, size: 64, dx: -8, dy: 7,  s0: 1.12, s1: 0.9,  dur: 61, delay: -30 },
  { h: 150, s: 62, l: 58, a: 0.19, ox: 54,    oy: 21.6,  size: 72, dx: -5, dy: -9, s0: 0.95, s1: 1.18, dur: 53, delay: -5 },
  { h: 190, s: 68, l: 58, a: 0.2,  ox: -28.8, oy: 43.2,  size: 68, dx: 9,  dy: 4,  s0: 1.08, s1: 0.92, dur: 68, delay: -41 },
  { h: 224, s: 70, l: 58, a: 0.16, ox: 3.6,   oy: -10.8, size: 86, dx: -6, dy: 6,  s0: 1.0,  s1: 1.15, dur: 74, delay: -22 },
  { h: 272, s: 64, l: 60, a: 0.21, ox: -61.2, oy: 14.4,  size: 62, dx: 7,  dy: -6, s0: 1.15, s1: 0.95, dur: 58, delay: -8 },
  { h: 318, s: 66, l: 60, a: 0.2,  ox: 21.6,  oy: 61.2,  size: 58, dx: -7, dy: -8, s0: 0.9,  s1: 1.2,  dur: 44, delay: -35 },
];
---

<div class="mesh" aria-hidden="true">
  <div class="mesh__field">
    {
      BLOBS.map((b) => (
        <div
          class="mesh__blob"
          style={`
            --size:${b.size}vmax;
            --c:hsl(${b.h} ${b.s}% ${b.l}% / ${b.a});
            --ox:${b.ox}vw; --oy:${b.oy}vh;
            --dx:${b.dx}vmax; --dy:${b.dy}vmax;
            --s0:${b.s0}; --s1:${b.s1};
            --dur:${b.dur}s; --delay:${b.delay}s;
          `}
        />
      ))
    }
  </div>
</div>

<style>
  .mesh {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    contain: layout paint;
  }

  /* zero-size anchor at the middle of the viewport: the blobs orbit this */
  .mesh__field {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    animation: mesh-turn 210s linear infinite;
    will-change: transform;
  }

  .mesh__blob {
    position: absolute;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    /* soft by construction — no blur filter needed */
    background: radial-gradient(circle closest-side, var(--c), transparent 72%);
    mix-blend-mode: screen;
    will-change: transform;
    animation: mesh-drift var(--dur) ease-in-out var(--delay) infinite alternate;
  }

  @keyframes mesh-turn {
    to { transform: rotate(360deg); }
  }

  /* one keyframe pair; each blob's own path comes from its custom properties */
  @keyframes mesh-drift {
    from {
      transform: translate(-50%, -50%) translate(var(--ox), var(--oy)) scale(var(--s0));
    }
    to {
      transform: translate(-50%, -50%)
        translate(calc(var(--ox) + var(--dx)), calc(var(--oy) + var(--dy)))
        scale(var(--s1));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mesh__field,
    .mesh__blob {
      animation: none;
      will-change: auto;
    }
    /* the keyframes are what positioned the blob, so place it by hand */
    .mesh__blob {
      transform: translate(-50%, -50%) translate(var(--ox), var(--oy)) scale(var(--s0));
    }
  }
</style>
