---
/**
 * Showcase
 * --------
 * Apple-style product intro above a project writeup. The stage pins to the
 * viewport while the section scrolls past it:
 *
 *   1. the first clip/photo fills the screen under the title
 *   2. scrolling crossfades through the rest, each easing out of a slow zoom
 *   3. at the end the frame shrinks into a rounded card and scrolls away,
 *      handing off to the writeup underneath
 *
 * The section is tall (≈120vh of scroll per item, plus the outro); everything
 * is driven by how far it has been scrolled, so it runs backwards too.
 * Only transform / opacity / border-radius change per frame — no filters, no
 * blur (see the svg-filter perf notes; this site already paid for that once).
 *
 * Media comes from the project's public folder (discoverMedia) unless the
 * frontmatter lists it explicitly.
 */
import { discoverMedia, webVideoPath } from "../lib/images.mjs";
import { imageAttrs, withBase } from "../lib/url";

interface Props {
  /** public folder to pull media from, e.g. "/projects/frc-reefscape-2025" */
  dir: string;
  title: string;
  kicker?: string;
  tagline?: string;
  media?: { src: string; caption?: string }[];
}
const { dir, title, kicker, tagline, media } = Astro.props;

type Item = { type: "video" | "image"; src: string; poster?: string; caption?: string };
const raw: Item[] = media
  ? media.map((m) =>
      /\.(mov|m4v)$/i.test(m.src)
        ? { type: "video", src: webVideoPath(m.src), poster: webVideoPath(m.src).replace(/\.web\.mp4$/, ".poster.jpg"), caption: m.caption }
        : /\.mp4$/i.test(m.src)
          ? { type: "video", src: m.src, caption: m.caption }
          : { type: "image", src: m.src, caption: m.caption })
  : discoverMedia(dir);

// images and posters go through the resized WebP variants; the stage is full-bleed
const items = await Promise.all(
  raw.map(async (it) => ({
    ...it,
    img: it.type === "image" ? await imageAttrs(it.src, "100vw") : undefined,
    posterSrc: it.poster ? (await imageAttrs(it.poster, "100vw")).src : undefined,
  })),
);
---

{items.length > 0 && (
  <section class="sc" data-showcase style={`--n:${items.length}`} aria-label={`${title} showcase`}>
    <div class="sc__stage">
      <div class="sc__frame">
        {items.map((it, i) => (
          <div class="sc__layer" data-i={i}>
            {it.type === "video" ? (
              <video
                src={withBase(it.src)}
                poster={it.posterSrc}
                muted
                loop
                playsinline
                preload={i === 0 ? "auto" : "none"}
                aria-hidden="true"
              ></video>
            ) : (
              <img {...it.img} alt="" decoding="async" loading={i === 0 ? "eager" : "lazy"} />
            )}
            {it.caption && <p class="sc__cap mono">{it.caption}</p>}
          </div>
        ))}
        <div class="sc__scrim" aria-hidden="true"></div>

        <div class="sc__title">
          {kicker && <p class="sc__kicker mono">{kicker}</p>}
          <h2>{title}</h2>
          {tagline && <p class="sc__tagline">{tagline}</p>}
        </div>
      </div>

      {items.length > 1 && (
        <ol class="sc__dots" aria-hidden="true">
          {items.map((_, i) => <li data-dot={i}></li>)}
        </ol>
      )}
      <div class="sc__hint mono" aria-hidden="true"><span>scroll</span><i></i></div>
    </div>
  </section>
)}

<style>
  .sc {
    /* ~120vh of scrolling per item, plus room for the outro */
    height: calc((var(--n) * 120 + 110) * 1vh);
    height: calc((var(--n) * 120 + 110) * 1svh);
    position: relative;
  }
  .sc__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .sc__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
    transform-origin: 50% 40%;
    will-change: transform;
  }

  .sc__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    will-change: opacity;
  }
  .sc__layer:first-child { opacity: 1; }
  .sc__layer video,
  .sc__layer img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  .sc__cap {
    position: absolute;
    right: clamp(16px, 4vw, 48px);
    bottom: clamp(20px, 5vh, 44px);
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  /* darkens the bottom-left for the title, plus a light overall dim so the
     type holds up over bright gym footage */
  .sc__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(6, 8, 12, 0.82) 0%, rgba(6, 8, 12, 0.25) 42%, rgba(6, 8, 12, 0) 65%),
      linear-gradient(to right, rgba(6, 8, 12, 0.45), rgba(6, 8, 12, 0) 55%);
    pointer-events: none;
  }

  .sc__title {
    position: absolute;
    left: clamp(16px, 6vw, 88px);
    right: clamp(16px, 6vw, 88px);
    bottom: clamp(56px, 12vh, 120px);
    color: #fff;
    will-change: transform, opacity;
  }
  .sc__kicker {
    margin: 0 0 10px;
    font-size: 11.5px;
    letter-spacing: 0.18em;
    color: var(--amber);
  }
  .sc__title h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 13vw, 10rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.035em;
  }
  .sc__tagline {
    margin: 16px 0 0;
    max-width: 34ch;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.82);
  }

  .sc__dots {
    position: absolute;
    right: clamp(12px, 2.4vw, 28px);
    top: 50%;
    translate: 0 -50%;
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sc__dots li {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.35);
    transition: height 0.3s ease, background-color 0.3s ease;
  }
  .sc__dots li.is-on { height: 22px; background: var(--amber); }

  .sc__hint {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    pointer-events: none;
  }
  .sc__hint i {
    width: 1px;
    height: 26px;
    background: linear-gradient(rgba(255, 255, 255, 0.7), transparent);
    animation: sc-drip 1.8s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes sc-drip {
    0% { transform: scaleY(0); opacity: 1; }
    60% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc__hint i { animation: none; }
  }
</style>

<script>
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const smooth = (a: number, b: number, v: number) => {
    const t = clamp01((v - a) / (b - a));
    return t * t * (3 - 2 * t);
  };

  function initShowcase(root: HTMLElement): () => void {
    const frame = root.querySelector<HTMLElement>(".sc__frame")!;
    const layers = Array.from(root.querySelectorAll<HTMLElement>(".sc__layer"));
    const media = layers.map((l) => l.querySelector<HTMLVideoElement | HTMLImageElement>("video, img")!);
    const title = root.querySelector<HTMLElement>(".sc__title")!;
    const hint = root.querySelector<HTMLElement>(".sc__hint")!;
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
    const n = layers.length;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ClientRouter builds the next page in a detached document, where Chrome
    // rejects the <video> src and never retries (see Video.astro). Kick it.
    for (const m of media) {
      if (m instanceof HTMLVideoElement && (m.error || m.networkState === HTMLMediaElement.NETWORK_NO_SOURCE)) m.load();
    }

    // tuck the stage up under the translucent site header, like a product
    // page's hero; the header wraps on phones, so measure rather than guess
    const bar = document.querySelector<HTMLElement>(".topbar");
    const tuck = () => { root.style.marginTop = bar ? `-${bar.offsetHeight}px` : ""; };
    tuck();

    let inView = false;
    let raf = 0;
    let lastActive = -1;

    function frameUpdate() {
      raf = 0;
      const vh = window.innerHeight;
      const scrolled = -root.getBoundingClientRect().top;
      const total = root.offsetHeight - vh; // how far the stage stays pinned
      const outro = Math.min(vh * 0.9, total * 0.4);
      const itemsSpan = Math.max(1, total - outro);

      // x runs 0 → n-1 across the item span; whole numbers are "fully on" an
      // item. Each item gets an equal slice of the scroll, and the half-slice
      // offset means the first and last hold still before anything fades.
      const x = Math.min(n - 1, Math.max(0, clamp01(scrolled / itemsSpan) * n - 0.5));
      let active = 0, best = -1;
      layers.forEach((layer, i) => {
        const opacity = 1 - smooth(0.3, 0.7, Math.abs(x - i));
        layer.style.opacity = opacity.toFixed(3);
        if (opacity > best) { best = opacity; active = i; }
        // slow push-in: each item settles from 1.12 to 1.0 as it arrives, then keeps going
        const k = reduced ? 1 : 1.12 - 0.12 * smooth(-1, 0.6, x - i) - 0.04 * smooth(0, 1, x - i);
        media[i].style.transform = `scale(${k.toFixed(4)})`;

        const v = media[i];
        if (v instanceof HTMLVideoElement) {
          // start fetching the next clip as it gets close
          if (Math.abs(x - i) < 1.2 && v.preload !== "auto") v.preload = "auto";
          const shouldPlay = inView && opacity > 0.02 && !reduced;
          if (shouldPlay && v.paused) v.play().catch(() => {});
          else if (!shouldPlay && !v.paused) v.pause();
        }
      });
      if (active !== lastActive) {
        dots.forEach((d, i) => d.classList.toggle("is-on", i === active));
        lastActive = active;
      }

      // the title drifts up and out over the first ~third of a screen
      const t = smooth(0, vh * 0.38, scrolled);
      title.style.opacity = (1 - t).toFixed(3);
      title.style.transform = `translateY(${(-t * vh * 0.08).toFixed(1)}px)`;
      hint.style.opacity = (1 - smooth(0, vh * 0.12, scrolled)).toFixed(3);

      // outro: the full-bleed frame pulls back into a card, then the pin
      // releases and it scrolls away with the page
      const q = reduced ? 0 : smooth(total - outro, total, scrolled);
      frame.style.transform = `translateY(${(-q * vh * 0.04).toFixed(1)}px) scale(${(1 - q * 0.14).toFixed(4)})`;
      frame.style.borderRadius = `${(q * 28).toFixed(1)}px`;
      frame.style.opacity = (1 - q * 0.35).toFixed(3);
    }

    const schedule = () => { if (!raf) raf = requestAnimationFrame(frameUpdate); };
    const onResize = () => { tuck(); schedule(); };

    const io = new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      if (inView) {
        window.addEventListener("scroll", schedule, { passive: true });
        window.addEventListener("resize", onResize);
      } else {
        window.removeEventListener("scroll", schedule);
        window.removeEventListener("resize", onResize);
      }
      schedule(); // also pauses video on the way out
    });
    io.observe(root);
    frameUpdate();

    return () => {
      io.disconnect();
      cancelAnimationFrame(raf);
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", onResize);
      media.forEach((m) => m instanceof HTMLVideoElement && m.pause());
    };
  }

  // astro:page-load fires on first load and every view-transition navigation
  let cleanups: Array<() => void> = [];
  document.addEventListener("astro:page-load", () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
    document.querySelectorAll<HTMLElement>("[data-showcase]").forEach((el) => cleanups.push(initShowcase(el)));
  });
</script>
