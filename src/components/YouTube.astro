---
/**
 * Click-to-load YouTube embed. A real <iframe> pulls ~1 MB of YouTube's player
 * JS on page load whether anyone watches or not, so this renders the
 * thumbnail and a play button, and only swaps in the (nocookie) player on
 * click — autoplaying, since the click was the intent to watch.
 *
 * Without JS the button is a plain link to the video.
 */
interface Props {
  id: string;
  title: string;
  caption?: string;
}
const { id, title, caption } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${id}`;
---

<figure class="yt">
  <a class="yt__frame" href={watch} target="_blank" rel="noopener" data-yt={id} aria-label={`Play video: ${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
    <span class="yt__play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" /></svg>
    </span>
    <span class="yt__title">{title}</span>
  </a>
  {caption && <figcaption class="yt__cap">{caption}</figcaption>}
</figure>

<style>
  .yt { margin: 1.6em 0; }
  .yt__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    border: 1px solid var(--line);
    overflow: hidden;
    background: #000;
    color: #fff;
    text-decoration: none;
  }
  .yt__frame:hover { text-decoration: none; }
  /* hqdefault is 4:3 with letterbox bars baked in; cover crops them off */
  .yt .yt__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border: none;
    border-radius: 0;
    transition: transform 0.4s ease, opacity 0.3s ease;
  }
  .yt__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 8, 12, 0.85), rgba(6, 8, 12, 0.1) 55%);
  }
  .yt__frame:hover img { transform: scale(1.03); }
  /* bottom-right rather than centred: talk thumbnails put their title
     card in the middle, and a centred button sits right on top of it */
  .yt__play {
    position: absolute;
    right: 14px;
    bottom: 12px;
    z-index: 1;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--amber) 55%, transparent);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    color: var(--amber);
    transition: scale 0.2s ease;
  }
  .yt__frame:hover .yt__play { scale: 1.07; }
  .yt__play svg { width: 22px; height: 22px; fill: currentColor; margin-left: 3px; }
  .yt__title {
    position: absolute;
    left: 16px;
    right: 80px;
    bottom: 16px;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.85);
  }
  .yt__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 2; }
  .yt__cap { margin-top: 0.6em; font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-faint); }
</style>

<script>
  function setupYouTube() {
    document.querySelectorAll<HTMLAnchorElement>("a[data-yt]:not([data-yt-bound])").forEach((a) => {
      a.dataset.ytBound = "";
      a.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return; // let "open in new tab" through
        e.preventDefault();
        const f = document.createElement("iframe");
        f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0`;
        f.title = a.getAttribute("aria-label") ?? "YouTube video";
        f.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        f.allowFullscreen = true;
        a.appendChild(f);
        a.removeAttribute("href"); // it's a player now, not a link
      });
    });
  }
  document.addEventListener("astro:page-load", setupYouTube);
</script>
