---
/**
 * Rainbow comet cursor.
 *
 * The pointer itself is a ring: the native cursor is hidden and a small circle
 * follows it, opening up and going amber over anything clickable. The ring
 * tracks the raw pointer (set straight from the pointermove, not the rAF loop,
 * so it never feels behind the hand) while the comet below lags on its spring.
 *
 * A head that chases the pointer on a spring (so it lags, overshoots and settles
 * — the "inertia"), a tapered ribbon drawn from its recent history, and sparks
 * shed along the way. Hue advances with distance travelled, so a swipe paints a
 * band of spectrum. Left alone, the head breathes: the halo swells and dims on a
 * slow cycle while the hue keeps drifting, so a parked cursor is a colour
 * inhaling rather than a dead dot.
 *
 * Perf notes (see the SVG-filter lesson): one canvas, DPR capped at 2, no
 * shadowBlur / no filters — glow is a wide low-alpha pass under a bright core,
 * composited with `lighter`. The rAF loop parks itself when the pointer is
 * still and nothing is alive, and restarts on the next move.
 */
---

<canvas class="cursor-trail" aria-hidden="true"></canvas>
<div class="ring-cursor" aria-hidden="true">
  <span class="ring-cursor__ring"></span>
  <span class="ring-cursor__dot"></span>
</div>

<style>
  .cursor-trail {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 60;
    pointer-events: none;
    /* over a near-black workbench, screen keeps the sparks additive against
       page content instead of pasting a grey film over it */
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 320ms ease;
  }
  .cursor-trail.is-live { opacity: 1; }

  /* Hide the native arrow only once the script has actually taken over. If it
     bails — unsupported, reduced motion, or a bug in here — the page must never
     be left with no cursor at all, so this class is the switch. */
  :global(html.cursor-ring-on),
  :global(html.cursor-ring-on *) { cursor: none !important; }

  /* A cross-origin frame swallows every pointer event, so the ring can't follow
     the pointer in there and the frame's own document draws a native cursor
     instead. Hand the pointer back rather than leaving ours stranded at the
     boundary next to it — this covers the frame's own box; the JS below stands
     the ring down for the content inside. */
  :global(html.cursor-ring-on :is(iframe, embed, object)) { cursor: auto !important; }

  .ring-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 61;
    pointer-events: none;
    opacity: 0;
    transition: opacity 260ms ease;
    will-change: transform;
  }
  .ring-cursor.is-live { opacity: 1; }

  /* The wrapper carries the position and the children carry the scale, so the
     grow transition never gets applied to the follow — one transition on the
     wrapper would make the whole cursor swim behind the pointer. */
  .ring-cursor__ring,
  .ring-cursor__dot {
    position: absolute;
    border-radius: 50%;
    transition:
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 200ms ease,
      background-color 200ms ease,
      opacity 160ms ease;
  }
  .ring-cursor__ring {
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border: 1.4px solid color-mix(in srgb, var(--ink) 76%, transparent);
    /* a dark rim under the light one, so the circle survives a bright photo */
    box-shadow: 0 0 0 1px rgba(11, 13, 18, 0.45), inset 0 0 0 1px rgba(11, 13, 18, 0.3);
  }
  .ring-cursor__dot {
    width: 3.4px;
    height: 3.4px;
    margin: -1.7px 0 0 -1.7px;
    background: var(--ink);
    box-shadow: 0 0 0 1px rgba(11, 13, 18, 0.45);
  }

  /* clickable: the ring opens up and takes the site's link amber */
  .ring-cursor.is-over .ring-cursor__ring {
    transform: scale(1.75);
    border-color: var(--amber);
    background: color-mix(in srgb, var(--amber) 10%, transparent);
  }
  .ring-cursor.is-over .ring-cursor__dot {
    opacity: 0;
    transform: scale(0.4);
  }
  /* press: it snaps in, and stays open if it was already over a link */
  .ring-cursor.is-down .ring-cursor__ring { transform: scale(0.72); }
  .ring-cursor.is-over.is-down .ring-cursor__ring { transform: scale(1.4); }

  @media (prefers-reduced-motion: reduce) {
    .cursor-trail, .ring-cursor { display: none; }
  }
  /* touch / stylus-only devices never get a hover cursor to follow */
  @media (pointer: coarse), (max-width: 640px) {
    .cursor-trail, .ring-cursor { display: none; }
  }
</style>

<script>
  type Particle = {
    x: number; y: number;
    vx: number; vy: number;
    life: number; max: number;
    size: number; hue: number;
    spark: boolean;
  };

  function initCursorTrail(root: ParentNode) {
    const canvas = root.querySelector<HTMLCanvasElement>("canvas.cursor-trail");
    if (!canvas) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!window.matchMedia("(pointer: fine)").matches) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const ring = root.querySelector<HTMLElement>(".ring-cursor");
    if (!ring) return;
    // Everything that should make the ring open up. Kept as a selector list
    // rather than a computed-style check because the native cursor is hidden by
    // then, so `getComputedStyle(el).cursor` no longer tells us anything.
    const INTERACTIVE =
      'a[href], button, summary, select, label[for], [role="button"], [role="tab"],' +
      ' .sotm__handle, .vid__seek, .reef__robot, .reef__pip, img[data-zoomable]';
    // Anything hosting its own document. A cross-origin frame gives the parent
    // NOTHING once the pointer is inside it — measured at the boundary of the
    // FRC Rebuilt embed: the last event is a pointermove over the frame's own
    // bezel, then silence. No pointerout, no mouseout with a null relatedTarget,
    // no pointerover on the iframe element. So there is no entry event to hook;
    // the silence IS the signal. If moves stop while the pointer is on or right
    // next to a frame, it went in.
    const FRAME = "iframe, embed, object";
    const FRAME_MARGIN = 18;    // a fast move's last event lands just outside
    const FRAME_SILENCE = 100;  // ms without a pointer event == it's in there
    document.documentElement.classList.add("cursor-ring-on");

    let w = 0, h = 0, dpr = 1;
    // declared up here because resize() writes it and runs before the state
    // block below — a `let` down there would be in its TDZ and throw.
    let needFullClear = true;
    // Up here with needFullClear, and for the same reason: resize() writes it and
    // runs before the state block below, where a `let` would still be in its TDZ.
    let frameRects: DOMRect[] | null = null;
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      needFullClear = true;
      frameRects = null;
    }
    resize();

    // --- state -------------------------------------------------------------
    let tx = w / 2, ty = h / 2;      // pointer target
    let x = tx, y = ty;              // comet head
    let vx = 0, vy = 0;              // head velocity
    let seen = false;                // pointer has been somewhere real
    let hue = Math.random() * 360;   // rides forward every frame
    let idle = 0;                    // ms since the pointer last moved
    let overFrame = false;           // pointer is inside an embedded document
    let frameTimer = 0;
    let breath = 0;                  // free-running breath phase clock
    let rest = 0;                    // 0 = travelling, 1 = fully settled (eased)
    let raf = 0;
    let running = false;
    let last = performance.now();

    const SPRING = 0.16;   // pull toward the pointer
    const DAMP = 0.76;     // how much velocity survives each frame
    const TRAIL_MAX = 34;
    // Hue advances with DISTANCE travelled, not with time. That's what makes it
    // read as a rainbow: one swipe paints a band of spectrum across the screen,
    // and a parked cursor holds its colour instead of strobing. The small
    // constant keeps it just barely alive when the head is creeping.
    const HUE_PER_PX = 0.85;
    const HUE_IDLE = 0.5;
    const BREATH_MS = 3400;  // one inhale+exhale; near a real resting breath
    const REST_CLEAR = 64;   // half-size of the idle dirty-rect, > the widest halo

    const trail: { x: number; y: number; hue: number }[] = [];
    const parts: Particle[] = [];
    const POOL_MAX = 320;

    // --- emission ----------------------------------------------------------
    function spark(px: number, py: number, sp: number, hu: number, burst = false) {
      if (parts.length >= POOL_MAX) return;
      const a = Math.random() * Math.PI * 2;
      const s = burst ? 1.6 + Math.random() * 3.4 : Math.random() * 1.5;
      const isSpark = Math.random() < 0.22;
      parts.push({
        x: px + (Math.random() - 0.5) * 6,
        y: py + (Math.random() - 0.5) * 6,
        // inherit a slice of the head's momentum so the shower streams behind it
        vx: Math.cos(a) * s + vx * (burst ? 0.05 : 0.22),
        vy: Math.sin(a) * s + vy * (burst ? 0.05 : 0.22),
        life: 0,
        max: (burst ? 620 : 460) + Math.random() * (burst ? 520 : 460),
        size: isSpark ? 0.8 + Math.random() * 0.9 : 1.4 + Math.random() * (1.8 + sp * 0.05),
        // a click throws the whole spectrum at once; the trail keeps a tight band
        hue: hu + (Math.random() - 0.5) * (burst ? 360 : 70),
        spark: isSpark,
      });
    }

    // --- frame -------------------------------------------------------------
    function frame(now: number) {
      const dt = Math.min(now - last, 48);
      last = now;
      const step = dt / 16.667; // frame-rate independent-ish

      // spring the head toward the pointer
      vx += (tx - x) * SPRING * step;
      vy += (ty - y) * SPRING * step;
      const d = Math.pow(DAMP, step);
      vx *= d; vy *= d;
      const px = x, py = y;
      x += vx * step; y += vy * step;

      const speed = Math.hypot(vx, vy);

      // Ease into and out of the resting state so the breath doesn't pop on the
      // frame the cursor stops.
      const settled = seen && idle > 320 && speed < 0.09 ? 1 : 0;
      rest += (settled - rest) * 0.07 * step;
      breath += dt;
      const pulse = 0.5 - 0.5 * Math.cos(((breath % BREATH_MS) / BREATH_MS) * Math.PI * 2);

      // At rest the hue drifts faster than HUE_IDLE alone, so each breath comes
      // back a visibly different colour.
      hue = (hue + (HUE_IDLE + rest * 0.9) * step
                 + Math.hypot(x - px, y - py) * HUE_PER_PX) % 360;

      if (seen) {
        const tip = trail[trail.length - 1];
        // Only lay down a point when the head actually travelled. Parked, the
        // ribbon retracts into the head instead of stacking 34 copies of the
        // same dot and burning a hole in the page.
        if (!tip || Math.hypot(x - tip.x, y - tip.y) > 0.75) {
          trail.push({ x, y, hue });
          if (trail.length > TRAIL_MAX) trail.shift();
        } else if (trail.length) {
          trail.shift();
        }

        // more sparks the faster you fling it
        const n = Math.min(5, Math.floor(speed * 0.28));
        for (let i = 0; i < n; i++) spark(x, y, speed, hue);
        if (speed > 1.2 && Math.random() < 0.5) spark(x, y, speed, hue);
      } else if (trail.length) {
        trail.shift();
      }

      // While it's only breathing, the head is the sole thing on the canvas, so
      // clear a box around it instead of the whole viewport at DPR 2.
      const idleOnly = rest > 0.99 && parts.length === 0 && trail.length === 0;
      if (idleOnly && !needFullClear) {
        ctx!.clearRect(x - REST_CLEAR, y - REST_CLEAR, REST_CLEAR * 2, REST_CLEAR * 2);
      } else {
        ctx!.clearRect(0, 0, w, h);
      }
      needFullClear = !idleOnly;
      ctx!.globalCompositeOperation = "lighter";

      // --- ribbon: wide soft pass, then a bright core -----------------------
      ctx!.lineCap = "round";
      ctx!.lineJoin = "round";
      for (let pass = 0; pass < 2; pass++) {
        const glow = pass === 0;
        for (let i = 1; i < trail.length; i++) {
          const a = trail[i - 1], b = trail[i];
          const t = i / trail.length;              // 0 = tail, 1 = head
          const wdt = t * (glow ? 26 : 8) + 0.5;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(b.x, b.y);
          ctx!.lineWidth = wdt;
          ctx!.strokeStyle = glow
            ? `hsla(${b.hue}, 100%, 58%, ${0.075 * t * t})`
            : `hsla(${b.hue}, 100%, ${58 + t * 26}%, ${0.72 * t * t + 0.06})`;
          ctx!.stroke();
        }
      }

      // --- head: a small hot core with a halo that swells with speed --------
      if (seen) {
        // rest = 0 keeps the travelling head exactly as it was; rest = 1 swaps
        // in the breath — the halo grows and brightens on the inhale, shrinks
        // and dims on the exhale.
        const swell = rest * (0.5 + pulse * 2.0);
        const amp = 1 - rest + rest * (0.32 + pulse * 0.68);
        const r = 2.4 + Math.min(speed * 0.22, 3.4) + swell;

        const g = ctx!.createRadialGradient(x, y, 0, x, y, r * 6);
        g.addColorStop(0, `hsla(${hue}, 100%, 88%, ${0.85 * amp})`);
        g.addColorStop(0.28, `hsla(${hue + 30}, 100%, 65%, ${0.30 * amp})`);
        g.addColorStop(1, `hsla(${hue + 60}, 100%, 60%, 0)`);
        ctx!.fillStyle = g;
        ctx!.beginPath();
        ctx!.arc(x, y, r * 6, 0, Math.PI * 2);
        ctx!.fill();

        // a ring pushed out on each exhale, thinning as it goes
        if (rest > 0.02) {
          ctx!.strokeStyle = `hsla(${hue + 50}, 100%, 72%, ${0.22 * rest * (1 - pulse)})`;
          ctx!.lineWidth = 1.4;
          ctx!.beginPath();
          ctx!.arc(x, y, 10 + pulse * 30, 0, Math.PI * 2);
          ctx!.stroke();
        }

        ctx!.fillStyle = `hsla(${hue}, 100%, 95%, ${0.9 * amp})`;
        ctx!.beginPath();
        ctx!.arc(x, y, r * 0.55, 0, Math.PI * 2);
        ctx!.fill();
      }

      // --- sparks -----------------------------------------------------------
      for (let i = parts.length - 1; i >= 0; i--) {
        const p = parts[i];
        p.life += dt;
        if (p.life >= p.max) { parts.splice(i, 1); continue; }
        const k = 1 - p.life / p.max;
        p.vx *= Math.pow(0.94, step);
        p.vy *= Math.pow(0.94, step);
        p.vy += 0.018 * step;          // the faintest gravity, so they settle
        p.x += p.vx * step;
        p.y += p.vy * step;

        const alpha = k * k * (p.spark ? 0.95 : 0.6);
        ctx!.fillStyle = `hsla(${p.hue}, 100%, ${p.spark ? 92 : 66}%, ${alpha})`;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.size * (0.35 + k * 0.65), 0, Math.PI * 2);
        ctx!.fill();
      }

      ctx!.globalCompositeOperation = "source-over";

      // The head keeps breathing as long as the pointer is over the page, so the
      // loop only parks once the pointer has left (or the tab is hidden — see
      // onVis). Idle frames are one small gradient inside a 128px dirty rect.
      idle += dt;
      if (!seen && parts.length === 0 && trail.length === 0) {
        running = false;
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || document.visibilityState !== "visible") return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    // --- frames --------------------------------------------------------------
    // Cached because this is read on every pointermove and a getBoundingClientRect
    // per move would force layout; scrolling and resizing are what invalidate it.
    function frameBoxes() {
      if (!frameRects) {
        frameRects = Array.from(document.querySelectorAll(FRAME))
          .map((f) => f.getBoundingClientRect())
          .filter((r) => r.width > 0 && r.height > 0);
      }
      return frameRects;
    }

    function armFrameCheck() {
      clearTimeout(frameTimer);
      frameTimer = 0;
      if (overFrame) return;
      const near = frameBoxes().some(
        (r) =>
          tx >= r.left - FRAME_MARGIN && tx <= r.right + FRAME_MARGIN &&
          ty >= r.top - FRAME_MARGIN && ty <= r.bottom + FRAME_MARGIN,
      );
      if (near) frameTimer = window.setTimeout(() => setOverFrame(true), FRAME_SILENCE);
    }

    // a frame can also slide under a parked pointer
    function onScroll() {
      frameRects = null;
      armFrameCheck();
    }

    // --- input -------------------------------------------------------------
    const isFrame = (t: EventTarget | null) => {
      const el = t as Element | null;
      return !!(el && typeof el.closest === "function" && el.closest(FRAME));
    };

    /**
     * Entering an embed, the whole cursor system stands down: the ring and the
     * comet hide and the loop parks, so the embed's own native cursor is the
     * only one on screen. Coming back out, the next pointermove revives it and
     * snaps the comet head to the re-entry point instead of flying in from
     * wherever it was stranded.
     */
    function setOverFrame(on: boolean) {
      if (on === overFrame) return;
      overFrame = on;
      clearTimeout(frameTimer);
      frameTimer = 0;
      if (on) {
        ring!.classList.remove("is-live", "is-over", "is-down");
        canvas!.classList.remove("is-live");
        seen = false;
      } else {
        ring!.classList.add("is-live");
        canvas!.classList.add("is-live");
      }
    }

    function onMove(e: PointerEvent) {
      setOverFrame(isFrame(e.target));
      if (overFrame) return;
      tx = e.clientX; ty = e.clientY;
      lastPointer = { x: tx, y: ty };
      // straight off the event, not the rAF loop: the ring is the cursor now,
      // so any frame of lag would read as the pointer being broken
      ring!.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
      if (!seen) {
        // first sighting: drop the head on the pointer, don't fly in from 0,0
        seen = true; x = tx; y = ty; vx = vy = 0;
        canvas!.classList.add("is-live");
        ring!.classList.add("is-live");
      }
      idle = 0;
      start();
      armFrameCheck();
    }
    function onDown(e: PointerEvent) {
      if (overFrame) return;
      ring!.classList.add("is-down");
      for (let i = 0; i < 36; i++) spark(e.clientX, e.clientY, 6, hue, true);
      idle = 0;
      start();
    }
    function onUp() {
      ring!.classList.remove("is-down");
    }
    // pointerover bubbles and fires on every target change, so one listener
    // keeps the hover state current without any per-frame hit testing
    function onOver(e: PointerEvent) {
      // pointerover on the frame element is the last event we get before the
      // pointer disappears into it, so it's the hook for standing down
      setOverFrame(isFrame(e.target));
      if (overFrame) return;
      const t = e.target as Element | null;
      const hit = t && typeof t.closest === "function" ? t.closest(INTERACTIVE) : null;
      ring!.classList.toggle("is-over", !!hit);
    }
    function onLeave() {
      canvas!.classList.remove("is-live");
      ring!.classList.remove("is-live", "is-down", "is-over");
      seen = false;
    }
    function onEnter() {
      if (overFrame) return;
      if (trail.length === 0) seen = false;
      canvas!.classList.add("is-live");
      ring!.classList.add("is-live");
    }
    function onVis() {
      if (document.visibilityState === "visible") { idle = 0; start(); }
      else if (raf) { cancelAnimationFrame(raf); raf = 0; running = false; }
    }

    // Pick the cursor back up where the last page left it.
    if (lastPointer) {
      tx = x = lastPointer.x;
      ty = y = lastPointer.y;
      vx = vy = 0;
      seen = true;
      ring.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
      const under = document.elementFromPoint(tx, ty);
      if (under?.closest(FRAME)) {
        // the pointer was left sitting on an embed — stay down
        overFrame = true;
        seen = false;
      } else {
        ring.classList.add("is-live");
        ring.classList.toggle("is-over", !!under?.closest(INTERACTIVE));
        canvas.classList.add("is-live");
        start();
      }
    }

    window.addEventListener("pointermove", onMove, { passive: true });
    window.addEventListener("pointerdown", onDown, { passive: true });
    window.addEventListener("pointerup", onUp, { passive: true });
    window.addEventListener("pointercancel", onUp, { passive: true });
    document.addEventListener("pointerover", onOver);
    document.addEventListener("pointerleave", onLeave);
    document.addEventListener("pointerenter", onEnter);
    document.addEventListener("visibilitychange", onVis);
    window.addEventListener("resize", resize);
    window.addEventListener("scroll", onScroll, { passive: true });

    return () => {
      if (raf) cancelAnimationFrame(raf);
      running = false;
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerdown", onDown);
      window.removeEventListener("pointerup", onUp);
      window.removeEventListener("pointercancel", onUp);
      document.removeEventListener("pointerover", onOver);
      document.documentElement.classList.remove("cursor-ring-on");
      document.removeEventListener("pointerleave", onLeave);
      document.removeEventListener("pointerenter", onEnter);
      document.removeEventListener("visibilitychange", onVis);
      window.removeEventListener("resize", resize);
      window.removeEventListener("scroll", onScroll);
      clearTimeout(frameTimer);
    };
  }

  // The canvas node is swapped on view-transition navigations, so tear the old
  // loop down before binding the new one. The pointer position outlives the
  // swap: with the native cursor hidden, a fresh page that waits for the first
  // pointermove would leave the user with no visible cursor at all.
  let lastPointer: { x: number; y: number } | null = null;
  let stopTrail: (() => void) | null = null;
  function boot() {
    stopTrail?.();
    stopTrail = initCursorTrail(document) ?? null;
  }
  document.addEventListener("astro:page-load", boot);
</script>
