---
/**
 * Rainbow comet cursor.
 *
 * A head that chases the pointer on a spring (so it lags, overshoots and settles
 * — the "inertia"), a tapered ribbon drawn from its recent history, and sparks
 * shed along the way. Hue advances with distance travelled, so a swipe paints a
 * band of spectrum. Left alone, the head breathes: the halo swells and dims on a
 * slow cycle while the hue keeps drifting, so a parked cursor is a colour
 * inhaling rather than a dead dot.
 *
 * Perf notes (see the SVG-filter lesson): one canvas, DPR capped at 2, no
 * shadowBlur / no filters — glow is a wide low-alpha pass under a bright core,
 * composited with `lighter`. The rAF loop parks itself when the pointer is
 * still and nothing is alive, and restarts on the next move.
 */
---

<canvas class="cursor-trail" aria-hidden="true"></canvas>

<style>
  .cursor-trail {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 60;
    pointer-events: none;
    /* over a near-black workbench, screen keeps the sparks additive against
       page content instead of pasting a grey film over it */
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 320ms ease;
  }
  .cursor-trail.is-live { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .cursor-trail { display: none; }
  }
  /* touch / stylus-only devices never get a hover cursor to follow */
  @media (pointer: coarse), (max-width: 640px) {
    .cursor-trail { display: none; }
  }
</style>

<script>
  type Particle = {
    x: number; y: number;
    vx: number; vy: number;
    life: number; max: number;
    size: number; hue: number;
    spark: boolean;
  };

  function initCursorTrail(root: ParentNode) {
    const canvas = root.querySelector<HTMLCanvasElement>("canvas.cursor-trail");
    if (!canvas) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!window.matchMedia("(pointer: fine)").matches) return;

    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    let w = 0, h = 0, dpr = 1;
    // declared up here because resize() writes it and runs before the state
    // block below — a `let` down there would be in its TDZ and throw.
    let needFullClear = true;
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      needFullClear = true;
    }
    resize();

    // --- state -------------------------------------------------------------
    let tx = w / 2, ty = h / 2;      // pointer target
    let x = tx, y = ty;              // comet head
    let vx = 0, vy = 0;              // head velocity
    let seen = false;                // pointer has been somewhere real
    let hue = Math.random() * 360;   // rides forward every frame
    let idle = 0;                    // ms since the pointer last moved
    let breath = 0;                  // free-running breath phase clock
    let rest = 0;                    // 0 = travelling, 1 = fully settled (eased)
    let raf = 0;
    let running = false;
    let last = performance.now();

    const SPRING = 0.16;   // pull toward the pointer
    const DAMP = 0.76;     // how much velocity survives each frame
    const TRAIL_MAX = 34;
    // Hue advances with DISTANCE travelled, not with time. That's what makes it
    // read as a rainbow: one swipe paints a band of spectrum across the screen,
    // and a parked cursor holds its colour instead of strobing. The small
    // constant keeps it just barely alive when the head is creeping.
    const HUE_PER_PX = 0.85;
    const HUE_IDLE = 0.5;
    const BREATH_MS = 3400;  // one inhale+exhale; near a real resting breath
    const REST_CLEAR = 64;   // half-size of the idle dirty-rect, > the widest halo

    const trail: { x: number; y: number; hue: number }[] = [];
    const parts: Particle[] = [];
    const POOL_MAX = 320;

    // --- emission ----------------------------------------------------------
    function spark(px: number, py: number, sp: number, hu: number, burst = false) {
      if (parts.length >= POOL_MAX) return;
      const a = Math.random() * Math.PI * 2;
      const s = burst ? 1.6 + Math.random() * 3.4 : Math.random() * 1.5;
      const isSpark = Math.random() < 0.22;
      parts.push({
        x: px + (Math.random() - 0.5) * 6,
        y: py + (Math.random() - 0.5) * 6,
        // inherit a slice of the head's momentum so the shower streams behind it
        vx: Math.cos(a) * s + vx * (burst ? 0.05 : 0.22),
        vy: Math.sin(a) * s + vy * (burst ? 0.05 : 0.22),
        life: 0,
        max: (burst ? 620 : 460) + Math.random() * (burst ? 520 : 460),
        size: isSpark ? 0.8 + Math.random() * 0.9 : 1.4 + Math.random() * (1.8 + sp * 0.05),
        // a click throws the whole spectrum at once; the trail keeps a tight band
        hue: hu + (Math.random() - 0.5) * (burst ? 360 : 70),
        spark: isSpark,
      });
    }

    // --- frame -------------------------------------------------------------
    function frame(now: number) {
      const dt = Math.min(now - last, 48);
      last = now;
      const step = dt / 16.667; // frame-rate independent-ish

      // spring the head toward the pointer
      vx += (tx - x) * SPRING * step;
      vy += (ty - y) * SPRING * step;
      const d = Math.pow(DAMP, step);
      vx *= d; vy *= d;
      const px = x, py = y;
      x += vx * step; y += vy * step;

      const speed = Math.hypot(vx, vy);

      // Ease into and out of the resting state so the breath doesn't pop on the
      // frame the cursor stops.
      const settled = seen && idle > 320 && speed < 0.09 ? 1 : 0;
      rest += (settled - rest) * 0.07 * step;
      breath += dt;
      const pulse = 0.5 - 0.5 * Math.cos(((breath % BREATH_MS) / BREATH_MS) * Math.PI * 2);

      // At rest the hue drifts faster than HUE_IDLE alone, so each breath comes
      // back a visibly different colour.
      hue = (hue + (HUE_IDLE + rest * 0.9) * step
                 + Math.hypot(x - px, y - py) * HUE_PER_PX) % 360;

      if (seen) {
        const tip = trail[trail.length - 1];
        // Only lay down a point when the head actually travelled. Parked, the
        // ribbon retracts into the head instead of stacking 34 copies of the
        // same dot and burning a hole in the page.
        if (!tip || Math.hypot(x - tip.x, y - tip.y) > 0.75) {
          trail.push({ x, y, hue });
          if (trail.length > TRAIL_MAX) trail.shift();
        } else if (trail.length) {
          trail.shift();
        }

        // more sparks the faster you fling it
        const n = Math.min(5, Math.floor(speed * 0.28));
        for (let i = 0; i < n; i++) spark(x, y, speed, hue);
        if (speed > 1.2 && Math.random() < 0.5) spark(x, y, speed, hue);
      } else if (trail.length) {
        trail.shift();
      }

      // While it's only breathing, the head is the sole thing on the canvas, so
      // clear a box around it instead of the whole viewport at DPR 2.
      const idleOnly = rest > 0.99 && parts.length === 0 && trail.length === 0;
      if (idleOnly && !needFullClear) {
        ctx!.clearRect(x - REST_CLEAR, y - REST_CLEAR, REST_CLEAR * 2, REST_CLEAR * 2);
      } else {
        ctx!.clearRect(0, 0, w, h);
      }
      needFullClear = !idleOnly;
      ctx!.globalCompositeOperation = "lighter";

      // --- ribbon: wide soft pass, then a bright core -----------------------
      ctx!.lineCap = "round";
      ctx!.lineJoin = "round";
      for (let pass = 0; pass < 2; pass++) {
        const glow = pass === 0;
        for (let i = 1; i < trail.length; i++) {
          const a = trail[i - 1], b = trail[i];
          const t = i / trail.length;              // 0 = tail, 1 = head
          const wdt = t * (glow ? 26 : 8) + 0.5;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          ctx!.lineTo(b.x, b.y);
          ctx!.lineWidth = wdt;
          ctx!.strokeStyle = glow
            ? `hsla(${b.hue}, 100%, 58%, ${0.075 * t * t})`
            : `hsla(${b.hue}, 100%, ${58 + t * 26}%, ${0.72 * t * t + 0.06})`;
          ctx!.stroke();
        }
      }

      // --- head: a small hot core with a halo that swells with speed --------
      if (seen) {
        // rest = 0 keeps the travelling head exactly as it was; rest = 1 swaps
        // in the breath — the halo grows and brightens on the inhale, shrinks
        // and dims on the exhale.
        const swell = rest * (0.5 + pulse * 2.0);
        const amp = 1 - rest + rest * (0.32 + pulse * 0.68);
        const r = 2.4 + Math.min(speed * 0.22, 3.4) + swell;

        const g = ctx!.createRadialGradient(x, y, 0, x, y, r * 6);
        g.addColorStop(0, `hsla(${hue}, 100%, 88%, ${0.85 * amp})`);
        g.addColorStop(0.28, `hsla(${hue + 30}, 100%, 65%, ${0.30 * amp})`);
        g.addColorStop(1, `hsla(${hue + 60}, 100%, 60%, 0)`);
        ctx!.fillStyle = g;
        ctx!.beginPath();
        ctx!.arc(x, y, r * 6, 0, Math.PI * 2);
        ctx!.fill();

        // a ring pushed out on each exhale, thinning as it goes
        if (rest > 0.02) {
          ctx!.strokeStyle = `hsla(${hue + 50}, 100%, 72%, ${0.22 * rest * (1 - pulse)})`;
          ctx!.lineWidth = 1.4;
          ctx!.beginPath();
          ctx!.arc(x, y, 10 + pulse * 30, 0, Math.PI * 2);
          ctx!.stroke();
        }

        ctx!.fillStyle = `hsla(${hue}, 100%, 95%, ${0.9 * amp})`;
        ctx!.beginPath();
        ctx!.arc(x, y, r * 0.55, 0, Math.PI * 2);
        ctx!.fill();
      }

      // --- sparks -----------------------------------------------------------
      for (let i = parts.length - 1; i >= 0; i--) {
        const p = parts[i];
        p.life += dt;
        if (p.life >= p.max) { parts.splice(i, 1); continue; }
        const k = 1 - p.life / p.max;
        p.vx *= Math.pow(0.94, step);
        p.vy *= Math.pow(0.94, step);
        p.vy += 0.018 * step;          // the faintest gravity, so they settle
        p.x += p.vx * step;
        p.y += p.vy * step;

        const alpha = k * k * (p.spark ? 0.95 : 0.6);
        ctx!.fillStyle = `hsla(${p.hue}, 100%, ${p.spark ? 92 : 66}%, ${alpha})`;
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.size * (0.35 + k * 0.65), 0, Math.PI * 2);
        ctx!.fill();
      }

      ctx!.globalCompositeOperation = "source-over";

      // The head keeps breathing as long as the pointer is over the page, so the
      // loop only parks once the pointer has left (or the tab is hidden — see
      // onVis). Idle frames are one small gradient inside a 128px dirty rect.
      idle += dt;
      if (!seen && parts.length === 0 && trail.length === 0) {
        running = false;
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || document.visibilityState !== "visible") return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    }

    // --- input -------------------------------------------------------------
    function onMove(e: PointerEvent) {
      tx = e.clientX; ty = e.clientY;
      if (!seen) {
        // first sighting: drop the head on the pointer, don't fly in from 0,0
        seen = true; x = tx; y = ty; vx = vy = 0;
        canvas!.classList.add("is-live");
      }
      idle = 0;
      start();
    }
    function onDown(e: PointerEvent) {
      for (let i = 0; i < 36; i++) spark(e.clientX, e.clientY, 6, hue, true);
      idle = 0;
      start();
    }
    function onLeave() {
      canvas!.classList.remove("is-live");
      seen = false;
    }
    function onEnter() {
      if (trail.length === 0) seen = false;
      canvas!.classList.add("is-live");
    }
    function onVis() {
      if (document.visibilityState === "visible") { idle = 0; start(); }
      else if (raf) { cancelAnimationFrame(raf); raf = 0; running = false; }
    }

    window.addEventListener("pointermove", onMove, { passive: true });
    window.addEventListener("pointerdown", onDown, { passive: true });
    document.addEventListener("pointerleave", onLeave);
    document.addEventListener("pointerenter", onEnter);
    document.addEventListener("visibilitychange", onVis);
    window.addEventListener("resize", resize);

    return () => {
      if (raf) cancelAnimationFrame(raf);
      running = false;
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerdown", onDown);
      document.removeEventListener("pointerleave", onLeave);
      document.removeEventListener("pointerenter", onEnter);
      document.removeEventListener("visibilitychange", onVis);
      window.removeEventListener("resize", resize);
    };
  }

  // The canvas node is swapped on view-transition navigations, so tear the old
  // loop down before binding the new one.
  let stopTrail: (() => void) | null = null;
  function boot() {
    stopTrail?.();
    stopTrail = initCursorTrail(document) ?? null;
  }
  document.addEventListener("astro:page-load", boot);
</script>
