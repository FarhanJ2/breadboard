---
/**
 * Scroll-driven "hero" clip: sits in the text column like any other video,
 * then as you scroll it grows to fill the whole viewport, holds there, and
 * shrinks back into the column before the page carries on.
 *
 * The section is several viewports tall; a sticky stage pins the clip while
 * you scroll through it, and the scroll progress drives the window's size.
 * Only one absolutely-positioned box changes size, so it's cheap to lay out
 * every frame. The video fills that box with object-fit: cover, so at column
 * size (16:9) you see the whole frame and at full screen it crops to fit.
 *
 * As it grows the video also scales up toward `focus`, so at full screen the
 * subject fills the frame instead of the room around it, and an optional
 * title fades in while it's held there.
 *
 * Always a bare, muted loop with no UI. Under reduced motion it's just an
 * inline clip.
 */
import { imageAttrs, withBase } from "../lib/url";

interface Props {
  /** site-root-relative path to the .mp4 */
  src: string;
  poster?: string;
  caption?: string;
  /** shown over the clip while it's full screen */
  title?: string;
  subtitle?: string;
  /** how far the video scales up by full screen (1 = no crop) */
  crop?: number;
  /** CSS transform-origin the crop zooms toward, e.g. "50% 55%" */
  focus?: string;
}
const { src, poster, caption, title, subtitle, crop = 1, focus = "50% 50%" } = Astro.props;
const posterSrc = poster ? (await imageAttrs(poster, "")).src : undefined;
---

<section class="zv" aria-label={caption} data-crop={crop} style={`--zv-focus: ${focus}`}>
  <div class="zv__stage">
    {caption && <p class="zv__cap mono">{caption}</p>}
    <div class="zv__win">
      <video src={withBase(src)} poster={posterSrc} muted loop playsinline preload="none" aria-label={caption}></video>
      {title && (
        <div class="zv__title" aria-hidden="true">
          <p class="zv__h">{title}</p>
          {subtitle && <p class="zv__sub mono">{subtitle}</p>}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /*
   * The pinned stage is a full viewport tall with the clip centred in it, which
   * would leave half a screen of empty space above and below. Pull the section
   * up and in by that much so the clip sits where a normal video would.
   * Percentage margins resolve against the column width, and the clip's
   * half-height is width x 9/16 / 2 = 28.125% of it.
   */
  .zv {
    position: relative;
    height: 320vh; /* scroll length of the zoom, grow + hold + shrink */
    margin: calc(28.125% - 50vh + 1.6em) 0 calc(28.125% - 50vh + 3.2em);
    margin: calc(28.125% - 50lvh + 1.6em) 0 calc(28.125% - 50lvh + 3.2em);
  }
  .zv__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    /* above the site header (50) while full screen; below the lightbox and cursor */
    z-index: 51;
    pointer-events: none;
  }
  .zv__win {
    position: absolute;
    /* JS owns left/top/width/height/radius; these are the column-size fallback */
    left: 0;
    top: 50%;
    width: 100%;
    aspect-ratio: 16 / 9;
    translate: 0 -50%;
    border-radius: 10px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.7);
  }
  .zv[data-live] .zv__win { translate: none; aspect-ratio: auto; }
  .zv video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: var(--zv-focus);
  }
  .zv__title {
    position: absolute;
    left: clamp(20px, 6vw, 96px);
    bottom: clamp(28px, 9vh, 110px);
    opacity: 0;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
  }
  .zv__h {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 6.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .zv__sub {
    margin: 0.9em 0 0;
    font-size: clamp(0.72rem, 1.1vw, 0.9rem);
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.72);
  }
  .zv__cap {
    position: absolute;
    left: 0;
    top: 75%;
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .zv { height: auto; margin: 1.6em 0; }
    .zv__stage { position: static; height: auto; }
    .zv__win { position: relative; top: auto; translate: none; }
    .zv__cap { position: static; margin-top: 0.6em; }
    .zv__title { display: none; }
  }
</style>

<script>
  const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  // how much of the pinned scroll each phase takes
  const GROW_END = 0.38;
  const SHRINK_START = 0.62;

  function init(sec: HTMLElement) {
    const stage = sec.querySelector<HTMLElement>(".zv__stage")!;
    const win = sec.querySelector<HTMLElement>(".zv__win")!;
    const cap = sec.querySelector<HTMLElement>(".zv__cap");
    const title = sec.querySelector<HTMLElement>(".zv__title");
    const crop = Number(sec.dataset.crop) || 1;
    const v = sec.querySelector("video")!;
    if (v.error || v.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) v.load();

    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) v.play().catch(() => {});
      else v.pause();
    });
    io.observe(sec);

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return () => io.disconnect();

    sec.dataset.live = "";
    let raf = 0;
    const frame = () => {
      raf = 0;
      const vw = document.documentElement.clientWidth;
      const vh = stage.clientHeight;
      const col = stage.getBoundingClientRect();
      const r = sec.getBoundingClientRect();
      const travel = r.height - vh;
      const p = clamp01(-r.top / travel);
      const z = p < GROW_END ? ease(p / GROW_END) : p > SHRINK_START ? ease(1 - (p - SHRINK_START) / (1 - SHRINK_START)) : 1;

      const w0 = col.width, h0 = (w0 * 9) / 16;
      const w = lerp(w0, vw, z), h = lerp(h0, vh, z);
      win.style.width = `${w}px`;
      win.style.height = `${h}px`;
      win.style.left = `${lerp(0, -col.left, z)}px`;
      win.style.top = `${lerp((vh - h0) / 2, 0, z)}px`;
      win.style.borderRadius = `${lerp(10, 0, z)}px`;
      // on a portrait screen object-fit: cover already crops most of the width
      // away, so extra zoom would push the subject off the edges
      const k = vw < vh ? 1 : crop;
      v.style.transform = k === 1 ? "" : `scale(${lerp(1, k, z)})`;
      if (title) {
        // only once it's essentially full screen, so it reads as the payoff
        const t = clamp01((z - 0.8) / 0.2);
        title.style.opacity = String(t);
        title.style.transform = `translateY(${(1 - t) * 18}px)`;
      }
      if (cap) {
        cap.style.top = `${(vh + h0) / 2 + 10}px`;
        cap.style.opacity = String(1 - Math.min(1, z * 3));
      }
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(frame); };
    frame();
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    return () => {
      io.disconnect();
      cancelAnimationFrame(raf);
      removeEventListener("scroll", queue);
      removeEventListener("resize", queue);
    };
  }

  let cleanups: Array<() => void> = [];
  document.addEventListener("astro:page-load", () => {
    cleanups.forEach((fn) => fn());
    cleanups = [...document.querySelectorAll<HTMLElement>(".zv")].map(init);
  });
</script>
