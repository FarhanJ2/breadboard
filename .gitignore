# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# generated by src/lib/images.mjs
public/**/*.800w.webp
public/**/*.1600w.webp

# public/contact holds ~1 GB of camera and phone originals (some over GitHub's
# 100 MB file limit). They stay local; only the web versions are committed.
public/contact/*
!public/contact/*.800w.webp
!public/contact/*.1600w.webp
!public/contact/*.web.mp4
!public/contact/*.poster.jpg
